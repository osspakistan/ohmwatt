{
  "autosave": "on_focus_change",
  "language_servers": ["eslint", "vue-language-server", "typescript-language-server"],
  "language_server_options": {
    "eslint": {
      "language_ids": ["vue", "typescript", "javascript", "typescriptreact", "javascriptreact"],
      "initialization_options": {
        "run_formatter": true
      }
    }
  },
  "languages": {
    "TypeScript": {
      "formatter": {
        "code_actions": {
          "source.fixAll.eslint": true
        }
      },
      "format_on_save": "on"
    },
    "Vue": {
      "formatter": {
        "code_actions": {
          "source.fixAll.eslint": true
        }
      },
      "format_on_save": "on"
    },
    "JavaScript": {
      "formatter": {
        "code_actions": {
          "source.fixAll.eslint": true
        }
      },
      "format_on_save": "on"
    }
  },
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "formatting": true
        }
      }
    },
    "vue-language-server": {
      "initialization_options": {
        "typescript": {
          "tsdk": "node_modules/typescript/lib"
        }
      }
    }
  },
  "formatter": {
    "code_actions": {
      "source.fixAll.eslint": true
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
