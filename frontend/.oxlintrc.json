{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue"],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/components/ui/**",
    "**/src-tauri/**",
    "**/vite-env.d.ts",
    "vite.config.ts",
    "tsconfig.json"
  ]
}
